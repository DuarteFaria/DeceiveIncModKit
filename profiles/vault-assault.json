  "mods": {
    "DIConfig": true,
    "DIExtraction": true
  },
  "diconfig": {
    "Timing": {
      "LobbyWaitTime": 15,
      "IntroPhaseTime": 5
    },
    "Extraction": {
      "Mode": "vault_assault",
      "AutoArm": 1,
      "AutoLoadout": 1,
      "AssaultTime": 120,
      "SecuredTime": 60,
      "DefenderFaction": 0,
      "AttackerFaction": 1,
      "TeleportDefenders": 1,
      "RemoveAmbientNPCs": 1,
      "DisableSuspicion": 1
    }
  },
  "tripwire": {
    "GameMode": "Trio",
    "bSandboxMode": "True",
    "MaxPlayers": "6",
    "BotsAmount": "5",
    "bFillWithBots": "True",
    "bIsPublic": "True",
    "bEnableUPnP": "True",
    "AutoShutdownEmptyMinutes": "60",
    "BotsDifficulty": "Difficult",
    "MapRotation": [
      "Diamondspire"
    ]
  }
}
