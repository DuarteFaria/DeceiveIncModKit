# Secrets and local operator config. The .example files are committed; these
# are not - they hold machine-specific paths and credentials.
.env
config.json

# Player name -> roster name/discord id overrides for the scrims push.
# Local operator data, not repo content.
scrims-aliases.json

# Match reports whose push failed, awaiting `scrims_push.py --flush`.
.scrims-queue/

# match_ids already pushed, so --watch cannot double-send. Local run state.
.scrims-pushed.json

# pid of the watcher started by `dimod launch`, removed by `dimod stop`.
.scrims-watcher.pid

__pycache__/
*.pyc

# --- Binaries that are not ours to redistribute -------------------------
# Local rollback copies of the game's own executable and of UE4SS. Both were
# verified byte-identical to the live install (sha256 recorded in
# baseline/native-runtime/*/manifest.sha256, which IS tracked), so nothing is
# lost by keeping them out of the repo - and Steam's "verify integrity of game
# files" restores the exe anyway. Keep them on disk; do not commit them.
# (baseline/*.exe.stock was deleted outright on 2026-09-02 - it duplicated
#  the native-runtime archive byte for byte. The pattern stays so a stray
#  copy is never committed again.)
baseline/*.exe.stock
baseline/native-runtime/**/*.exe.archive
baseline/native-runtime/**/ue4ss.dll

# CMake build trees, including compiler-probe executables and .tlog files.
# Regenerated by `cmake --preset vs2022-x64-release`.
native/**/build/
