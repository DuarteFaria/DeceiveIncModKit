# Copy to .env and fill in. .env is gitignored; this example is not.
#
#   cp .env.example .env
#
# tools/scrims_push.py loads .env from the kit root automatically. Real
# environment variables win over anything in here, so you can override a single
# value for one run without editing the file:
#
#   SCRIMS_LOBBY_ID=other-lobby python tools/scrims_push.py --map-id ... --map-index 1


# --- required ---------------------------------------------------------------

# Bearer token for the scrims API. Treat as a secret: never commit it, never
# paste it into a chat or an issue. scrims_push.py redacts it from its own error
# output, but it cannot redact your shell history.
SCRIMS_API_KEY=sk_test_replace_me_0000000000000000

# Base URL of the Convex deployment, scheme included, no trailing slash.
# The tool appends /api/lobbies/<lobby>/players and /scores itself.
SCRIMS_BASE_URL=https://example-deployment-123.convex.site


# --- optional ---------------------------------------------------------------

# Default lobby, so a whole scrim night does not need --lobby on every push.
# One server run maps to one lobby, so this is the natural place for it.
# Override per push with --lobby.
SCRIMS_LOBBY_ID=lobby_abc123
